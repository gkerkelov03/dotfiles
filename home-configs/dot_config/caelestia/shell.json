{
  "appearance": {
    "transparency": { "enabled": true, "base": 0.55, "layers": 0.8 }
  },

  "bar": {
    "persistent": false,
    "clock": { "showDate": true },
    "tray": { "background": true, "compact": true, "recolour": true },
    "workspaces": {
      "showWindows": false,
      "showWindowsOnSpecialWorkspaces": false
    },
    "statusIcons": [
      { "id": "lockStatus", "enabled": true },
      { "id": "audio", "enabled": false },
      { "id": "microphone", "enabled": false },
      { "id": "kbLayout", "enabled": true },
      { "id": "network", "enabled": true },
      { "id": "bluetooth", "enabled": true },
      { "id": "battery", "enabled": true }
    ]
  },

  "services": {
    "clockFormat": "TwentyFourHour",
    "weatherUnits": "Celsius",
    "dataUnits": "Decimal",
    "audioIncrement": 0.05,
    "brightnessIncrement": 0.05,
    "maxVolume": 2,
    "defaultPlayer": "Firefox",
    "visualiserBars": 20
  },

  "notifs": { "openExpanded": true, "actionOnClick": true },

  "utilities": {
    "maxToasts": 3,
    "toasts": { "fullscreen": "all" },
    "quickToggles": [
      { "id": "wifi", "enabled": true },
      { "id": "bluetooth", "enabled": true },
      { "id": "mic", "enabled": true },
      { "id": "settings", "enabled": true },
      { "id": "gameMode", "enabled": true },
      { "id": "dnd", "enabled": true },
      { "id": "vpn", "enabled": true }
    ],
    "vpn": {
      "enabled": false,
      "provider": [
        {
          "name": "wireguard",
          "interface": "your-connection-name",
          "displayName": "Wireguard (Your VPN)",
          "enabled": false
        }
      ]
    }
  },

  "osd": { "enableMicrophone": true },

  "background": {
    "desktopClock": {
      "enabled": true,
      "position": "top-left",
      "scale": 1.0,
      "invertColors": true,
      "background": { "enabled": false, "opacity": 0.7, "blur": true },
      "shadow": { "enabled": true, "opacity": 0.7, "blur": 0.4 }
    },
    "visualiser": {
      "enabled": true,
      "autoHide": true,
      "blur": true,
      "rounding": 1,
      "spacing": 1
    }
  },

  "border": { "thickness": 0, "smoothing": 0, "rounding": 0 },

  "lock": { "useWallpaper": true },

  "general": {
    "apps": { "explorer": ["yazi"] },
    "idle": {
      "timeouts": [
        {
          "timeout": 180,
          "idleAction": "lock",
          "inhibitWhenAudio": true,
          "respectInhibitors": true
        },
        { "timeout": 300, "idleAction": "dpms off", "returnAction": "dpms on" },
        { "timeout": 600, "idleAction": ["suspendThenHibernate"] }
      ]
    },
    "mediaGifSpeedAdjustment": 300,
    "sessionGifSpeed": 0.7
  },

  "session": {
    "icons": { "hibernate": "bedtime" },
    "commands": { "hibernate": ["systemctl", "suspend"] }
  },

  "launcher": {
    "favouriteApps": ["firefox", "org.keepassxc.KeePassXC", "yazi", "nvim"],
    "hiddenApps": [],
    "maxShown": 4,
    "maxWallpapers": 5,
    "enableDangerousActions": true,
    "vimKeybinds": true,
    "actions": [
      { "name": "Random", "enabled": false },
      { "name": "Sleep", "description": "Suspend", "command": ["suspend"] }
    ]
  },

  "paths": {
    "wallpaperDir": "/home/gkerkelov03/media/wallpapers",
    "lyricsDir": "~/junk",
    "sessionGif": "root:/assets/kurukuru.gif",
    "mediaGif": "root:/assets/bongocat.gif",
    "noNotifsPic": "root:/assets/dino.png",
    "lockNoNotifsPic": "root:/assets/dino.png"
  }
}
