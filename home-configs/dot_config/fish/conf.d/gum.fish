# Use ANSI palette indices only (0-15) so gum follows the terminal theme
# 1=red 2=green 3=yellow 4=blue 5=magenta 6=cyan 8=bright black (muted)

set -gx GUM_CHOOSE_CURSOR_FOREGROUND 5
set -gx GUM_CHOOSE_SELECTED_FOREGROUND 5
set -gx GUM_CHOOSE_HEADER_FOREGROUND 4

set -gx GUM_CONFIRM_PROMPT_FOREGROUND 4
set -gx GUM_CONFIRM_SELECTED_FOREGROUND 0
set -gx GUM_CONFIRM_SELECTED_BACKGROUND 5
set -gx GUM_CONFIRM_UNSELECTED_FOREGROUND 7
set -gx GUM_CONFIRM_UNSELECTED_BACKGROUND 8

set -gx GUM_INPUT_PROMPT_FOREGROUND 5
set -gx GUM_INPUT_CURSOR_FOREGROUND 5
set -gx GUM_INPUT_HEADER_FOREGROUND 4

set -gx GUM_FILTER_INDICATOR_FOREGROUND 5
set -gx GUM_FILTER_MATCH_FOREGROUND 6
set -gx GUM_FILTER_PROMPT_FOREGROUND 5

set -gx GUM_SPIN_SPINNER_FOREGROUND 5
set -gx GUM_SPIN_TITLE_FOREGROUND 7
