{
  "app_config": {
    "audio_config": {
      "audio": "pipewire"
    },
    "bluetooth_config": {
      "enabled": true
    },
    "fonts_config": {
      "fonts": ["noto-fonts", "noto-fonts-emoji", "noto-fonts-cjk"]
    },
    "print_service_config": {
      "enabled": true
    }
  },
  "archinstall_language": "English",
  "bootloader_config": {
    "bootloader": "Grub",
    "removable": true,
    "uki": true
  },
  "custom_commands": [],
  "firmware_optdeps": [],
  "hostname": "arch",
  "kernels": ["linux"],
  "locale_config": {
    "console_font": "default8x16",
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US.UTF-8"
  },
  "mirror_config": {
    "custom_repositories": [],
    "custom_servers": [
      {
        "url": "https://fastly.mirror.pkgbuild.com/$repo/os/$arch"
      },
      {
        "url": "https://geo.mirror.pkgbuild.com/$repo/os/$arch"
      }
    ],
    "mirror_regions": {},
    "optional_repositories": ["multilib"]
  },
  "network_config": {
    "type": "nm"
  },
  "ntp": true,
  "packages": ["git"],
  "pacman_config": {
    "color": true,
    "parallel_downloads": 5
  },
  "profile_config": {
    "gfx_driver": null,
    "greeter": null,
    "profile": {
      "custom_settings": {},
      "details": [],
      "main": "Minimal"
    }
  },
  "script": null,
  "services": [],
  "swap": {
    "algorithm": "zstd",
    "enabled": true
  },
  "timezone": "Europe/Sofia",
  "version": "4.5"
}
